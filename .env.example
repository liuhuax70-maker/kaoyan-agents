# ============================================================
# 考研智能体学习规划与督促系统 —— 环境变量模板
# 复制为 .env 后按需修改；嵌套配置使用双下划线 __ 分隔
# ============================================================

# ---------------- 应用 ----------------
APP__NAME=kaoyan-agents
APP__ENV=development
APP__DEBUG=true
APP__HOST=0.0.0.0
APP__PORT=8000
APP__API_PREFIX=/api
APP__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP__LOG_LEVEL=INFO
APP__LOG_JSON=false

# ---------------- 数据库 ----------------
# 生产/容器环境使用 PostgreSQL；本地无 Docker 时可换成 sqlite+aiosqlite:///./data/kaoyan.db
DATABASE__URL=postgresql+asyncpg://kaoyan:kaoyan@localhost:5432/kaoyan
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20

# ---------------- 缓存 / 消息队列 ----------------
REDIS__URL=redis://localhost:6379/0
CELERY__BROKER_URL=redis://localhost:6379/1
CELERY__RESULT_BACKEND=redis://localhost:6379/2
CELERY__TASK_ALWAYS_EAGER=true

# ---------------- 向量库（Milvus） ----------------
# backend=milvus 走真实 Milvus；backend=local 为无 Docker 时的本地兜底实现
# 注意：milvus-lite 不支持 Windows，因此 Windows 本地开发请用 local
VECTOR__BACKEND=milvus
VECTOR__MILVUS_URI=http://localhost:19530
VECTOR__MILVUS_TOKEN=
VECTOR__COLLECTION=kaoyan_knowledge
VECTOR__LOCAL_PATH=./data/vectorstore

# ---------------- 向量化（Embedding） ----------------
# DeepSeek 不提供 embedding 接口，因此单独配置
# provider 可选：stub（离线确定性哈希）/ ollama（bge-m3，推荐）/ openai / dashscope
EMBEDDING__PROVIDER=stub
EMBEDDING__DIMENSION=1024
EMBEDDING__BATCH_SIZE=16
EMBEDDING__OLLAMA_BASE_URL=http://localhost:11434/v1
EMBEDDING__OLLAMA_MODEL=bge-m3
EMBEDDING__OPENAI_API_KEY=
EMBEDDING__OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING__OPENAI_MODEL=text-embedding-3-small
EMBEDDING__DASHSCOPE_API_KEY=
EMBEDDING__DASHSCOPE_MODEL=text-embedding-v3

# ---------------- 知识库与检索增强 ----------------
KNOWLEDGE__ENABLED=true
KNOWLEDGE__ENABLE_RETRIEVAL=true
KNOWLEDGE__AUTO_INGEST=true
KNOWLEDGE__CHUNK_SIZE=320
KNOWLEDGE__CHUNK_OVERLAP=64
KNOWLEDGE__TOP_K=6
KNOWLEDGE__MIN_SCORE=0.12

# ---------------- 大模型 ----------------
# default_provider 可选：stub（离线桩）/ deepseek / ollama
LLM__DEFAULT_PROVIDER=stub
LLM__TEMPERATURE=0.3
LLM__MAX_TOKENS=2048
LLM__TIMEOUT_SECONDS=60
LLM__MAX_RETRIES=2

LLM__DEEPSEEK_API_KEY=
LLM__DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM__DEEPSEEK_MODEL=deepseek-chat

# 本地备选：Ollama（OpenAI 兼容端点）
LLM__OLLAMA_BASE_URL=http://localhost:11434/v1
LLM__OLLAMA_MODEL=qwen2.5:7b

LLM__OPENAI_API_KEY=
LLM__OPENAI_BASE_URL=https://api.openai.com/v1
LLM__OPENAI_MODEL=gpt-4o-mini

# ---------------- 多智能体协作 ----------------
# 生成计划后是否自动触发一轮计划评审
WORKFLOW__ENABLE_PLAN_REVIEW=true
# 评审执行方式：crew 走 CrewAI 多角色协作，local 走单智能体离线评审
WORKFLOW__PLAN_REVIEW_PROCESS=crew

# ---------------- 提醒督促 ----------------
REMINDER__ENABLED=true
REMINDER__DAILY_HOUR=8
REMINDER__OVERDUE_HOUR=20
REMINDER__IDLE_HOUR=21
REMINDER__WEEKLY_DIGEST_WEEKDAY=0
REMINDER__WEEKLY_DIGEST_HOUR=20
REMINDER__IDLE_THRESHOLD_DAYS=3
REMINDER__DISPATCH_BATCH_SIZE=200
REMINDER__MAX_RETRY=2

# ---------------- 可观测性（LangFuse） ----------------
OBSERVABILITY__LANGFUSE_ENABLED=false
OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
OBSERVABILITY__LANGFUSE_SECRET_KEY=
OBSERVABILITY__LANGFUSE_HOST=https://cloud.langfuse.com
